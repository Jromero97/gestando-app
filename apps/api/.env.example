# Comma-separated list of origins allowed to call this API from a browser
# (the landing page, and later any web app). Native/Expo clients aren't
# affected - they don't send an Origin header, so CORS never applies to them.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

PORT=3000
