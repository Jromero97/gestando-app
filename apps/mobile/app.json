{
  "expo": {
    "name": "GestandoApp",
    "slug": "gestando-app",
    "scheme": "gestandoapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "GestandoApp necesita acceso a tus fotos para subir imagenes de evolucion del embarazo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "GestandoApp necesita acceso al microfono para grabar notas de audio en tu diario.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-document-picker",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-mark.png",
          "color": "#E28A96"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fffaf0"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gestando.app"
    },
    "android": {
      "package": "com.gestando.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fffaf0"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d296b53e-19f3-4cbe-b9d1-385b4942d6ca"
      }
    },
    "owner": "jromero97"
  }
}
