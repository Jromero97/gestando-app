{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildArtifactPaths": ["android/app/build/outputs/**/*.{aab,apk}", "android/app/build/outputs/mapping/release/mapping.txt"]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
